<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

	<?php
		// Beide Kategorien werden identisch aufgebaut, deshalb nur eine Schleife.
		$arrKategorien = array
		(
			'A' => array('titel' => 'Kategorie A', 'zeilen' => $this->tabelleA, 'punkte' => 'gesamtpunkteA', 'turnier' => 'turnierpunkteA'),
			'B' => array('titel' => 'Kategorie B', 'zeilen' => $this->tabelleB, 'punkte' => 'gesamtpunkteB', 'turnier' => 'turnierpunkteB'),
		);
	?>

	<?php foreach ($arrKategorien as $strKategorie => $arrKategorie): ?>
		<div class="grandprix_container grandprix_kategorie_<?= strtolower($strKategorie) ?>">
			<h2><?= $arrKategorie['titel'] ?></h2>

			<?php if (empty($arrKategorie['zeilen'])): ?>
				<p class="empty">Für diese Kategorie liegen noch keine Ergebnisse vor.</p>
			<?php else: ?>
				<table>
					<thead>
						<tr>
							<th scope="col">Pl.</th>
							<th scope="col">Teilnehmer</th>
							<th scope="col">DWZ</th>
							<th scope="col">Kat.</th>
							<th scope="col">Gesamt</th>
							<th scope="col">Turniere</th>
							<?php for ($x = 1; $x <= $this->anzahlTurniere; ++$x): ?>
								<th scope="col">T<?= $x ?></th>
							<?php endfor; ?>
						</tr>
					</thead>
					<tbody>
						<?php foreach ($arrKategorie['zeilen'] as $arrItem): ?>
							<tr>
								<td><?= $arrItem['platz'] ?></td>
								<td><?= \Contao\StringUtil::specialchars((string) $arrItem['playername']) ?></td>
								<td><?= \Contao\StringUtil::specialchars((string) $arrItem['playerdwz']) ?></td>
								<td><?= $arrItem['kategorie'] ?></td>
								<td><?= $arrItem[$arrKategorie['punkte']] ?></td>
								<td><?= $arrItem['turniere'] ?></td>
								<?php for ($x = 1; $x <= $this->anzahlTurniere; ++$x): ?>
									<?php // Die Werte können bereits <s>...</s> für Streichwertungen enthalten ?>
									<td><?= $arrItem[$arrKategorie['turnier']][$x] ?? '' ?></td>
								<?php endfor; ?>
							</tr>
						<?php endforeach; ?>
					</tbody>
				</table>
			<?php endif; ?>
		</div>
	<?php endforeach; ?>

<?php $this->endblock(); ?>
